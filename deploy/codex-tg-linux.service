[Unit]
Description=codex-tg Telegram bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=azureuser
Group=azureuser
WorkingDirectory=/opt/telegram-agent/workspace
EnvironmentFile=/etc/codex-tg.env
Environment=CTR_GO_HOME=/opt/telegram-agent/state
Environment=CTR_GO_CODEX_BIN=/usr/local/bin/codex
Environment=CTR_GO_CODEX_CHATS_ROOT=/opt/telegram-agent/workspace
Environment=CTR_GO_REQUEST_TIMEOUT_SECONDS=1800
ExecStart=/opt/telegram-agent/bin/ctr-go daemon run
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/opt/telegram-agent /home/azureuser/.codex
MemoryMax=700M
TasksMax=128

[Install]
WantedBy=multi-user.target
